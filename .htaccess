# Pretty URLs for static HTML pages.
# Use this file only when the active virtual host runs Apache with mod_rewrite enabled.
Options -MultiViews
RewriteEngine On

# Keep the home page at /, not /index.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Canonicalise direct requests for HTML pages to extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html(?:[\s?]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Resolve an extensionless request to the matching .html file.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [END]
